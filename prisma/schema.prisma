generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Kategori {
  Processor
  Motherboard
  GraphicsCard
  Memory
  Storage
  PowerSupply
  Case
  Cooler
}

model Komponen {
  id         Int       @id @default(autoincrement())
  nama       String    @unique
  kategori   Kategori
  harga      Int
  deskripsi  String
  tersedia   Boolean   @default(true)
  gambar     String?
  dibuatPada DateTime  @default(now())
  ulasan     Ulasan[]
}

model Ulasan {
  id         Int       @id @default(autoincrement())
  nama       String
  nilai      Int
  komentar   String
  dibuatPada DateTime  @default(now())
  komponenId Int
  komponen   Komponen  @relation(fields: [komponenId], references: [id], onDelete: Restrict)

  @@unique([komponenId, nama])
}

model Pengguna {
  id           Int                @id @default(autoincrement())
  username     String             @unique
  email        String             @unique
  namaLengkap  String?
  passwordHash String
  peran        String             @default("user")
  dibuatPada   DateTime           @default(now())
  sesi         SesiPengguna[]
  rakitan      RakitanTersimpan[]
}

model SesiPengguna {
  id          String   @id
  penggunaId  Int
  pengguna    Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  kedaluwarsa DateTime
  dibuatPada  DateTime @default(now())
}

model RakitanTersimpan {
  id           Int      @id @default(autoincrement())
  nama         String
  komponenJson String
  totalHarga   Int
  estimasiWatt Int
  dibuatPada   DateTime @default(now())
  penggunaId   Int
  pengguna     Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
}
